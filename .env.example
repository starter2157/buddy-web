# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses Row Level Security — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for POST /api/cron/match, called by pg_cron through pg_net.
CRON_SECRET=generate-a-long-random-string

# Canonical origin, used to build the OAuth redirect URL. Set this in
# production so a forwarded host cannot send sign-in somewhere else.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local testing only: pretend the server clock is somewhere else, so every
# phase can be tried without editing the schedule. Ignored in production
# unless ALLOW_TIME_TRAVEL=1 is set as well, and never readable by a visitor.
# DEMO_NOW=2026-11-07T18:00:00+07:00
# ALLOW_TIME_TRAVEL=1
