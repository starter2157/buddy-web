# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses Row Level Security — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for POST /api/cron/match, called by pg_cron through pg_net.
CRON_SECRET=generate-a-long-random-string

# Canonical origin, used to build the OAuth redirect URL. Set this in
# production so a forwarded host cannot send sign-in somewhere else.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
